{
	# usa email da env (opcional) para ACME/Let's Encrypt
	email {$CADDY_ACME_EMAIL}
	admin off
}

# Redireciona sempre para o domínio canônico (sem www)
www.eknotech.com.br {
	redir https://eknotech.com.br{uri} permanent
}

# Site principal
eknotech.com.br {
	encode zstd gzip

	# arquivos do build (copiados para /usr/share/caddy no Dockerfile)
	root * /usr/share/caddy

	# SPA fallback (Vue Router history)
	try_files {path} /index.html

	# Headers de segurança
	header {
		# Segurança de transporte (habilita só quando tudo estiver em HTTPS estável)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Política de conteúdo (ajuste caso bloqueie scripts/estilos externos do seu projeto)
		Content-Security-Policy "default-src 'self'; img-src * data: https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https:; font-src 'self' https: data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

		# Outras proteções
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	file_server

	# (Opcional) log de acesso
	# log {
	# 	output stdout
	# 	format console
	# }
}
